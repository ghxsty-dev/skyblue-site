# ============================================================
# SkyBlue - Ortam Degiskenleri Sablonu
# Bu dosyayi kopyalayip .env.local yapin ve degerleri doldurun.
# Vercel'de: Project > Settings > Environment Variables
# NEXT_PUBLIC_ ile baslayanlar build aninda gömülür:
# degistirdikten sonra MUTLAKA redeploy gerekir.
# ============================================================

# --- Supabase (HESAP SISTEMI ICIN ZORUNLU) ---
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Ayni sayfada "service_role" (gizli tutun, tarayiciya verilmez)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Guvenlik gizli anahtarlari (ZORUNLU, rastgele uretin) ---
# Uretmek icin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Her biri icin ayri deger kullanin. Degistirirseniz mevcut IP kayitlari
# ve yayinlanmis premium/Discord kodlari gecersiz kalir.
IP_HASH_SECRET=
PREMIUM_CODE_SECRET=
DISCORD_VERIFY_SECRET=

# --- Discord bot (tasarimlar, yorumlar, DM, premium rolu icin) ---
# https://discord.com/developers/applications > Bot > Token
DISCORD_BOT_TOKEN=
# Ayni sayfada General Information > Public Key (slash komutlari icin)
DISCORD_PUBLIC_KEY=

# --- Gemini AI (rank araci yapay zeka onerisi icin, premium) ---
# https://aistudio.google.com/app/apikey
# Tanimli degilse AI oneri dugmesi kapalidir.
GEMINI_API_KEY=
# Opsiyonel model secimi (varsayilan: gemini-3.5-flash-lite)
GEMINI_MODEL=

# --- Cloudflare Turnstile captcha (OPS IYONEL ama onerilir) ---
# https://dash.cloudflare.com > Turnstile > widget olusturun
# Tanimli degilse captcha sessizce devre disi kalir.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
